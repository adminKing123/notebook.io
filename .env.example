# Django — local: python manage.py runserver (http://127.0.0.1:8000)
SECRET_KEY=django-insecure-personaldiary-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend — local Vite dev server (http://localhost:5173)
# fe/vite.config.js proxies /api -> http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

OTP_EXPIRY_MINUTES=10

# CDN (GitHub raw assets)
CDN_PROVIDER=github
CDN_UPLOADS_FOLDER=uploads
CDN_IMAGE_FORMAT=WEBP
CDN_IMAGE_MAX_WIDTH=1200
CDN_IMAGE_QUALITY=85
CDN_PUBLIC_BASE_URL=https://raw.githubusercontent.com/your-github-username/your-repo-name/main

CDN_GITHUB_USERNAME=your-github-username
CDN_GITHUB_REPO=your-repo-name
CDN_GITHUB_BRANCH=main
CDN_GITHUB_TOKEN=your-github-personal-access-token
